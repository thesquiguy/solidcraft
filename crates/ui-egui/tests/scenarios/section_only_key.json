[
  {"note": "Section Only: with a Section Analysis on, Alt+S shows only its cut face and Alt+S again shows the whole cut model. Each query below turns it over and gives the new state, so it reads the state the key left."},
  {"call": "engine.execute", "params": {"command": "solid.box", "params": {"length": 40, "width": 30, "height": 20}}},
  {"call": "engine.execute", "params": {"command": "inspect.section", "params": {"plane": "XZ", "at": 15}}},
  {"frames": 2},
  {"key": "S", "alt": true},
  {"frames": 2},
  {"expect": {"errors": 0}},
  {"expect": {"query": {"command": "inspect.section_only", "path": ["on"], "value": false}}},
  {"key": "S", "alt": true},
  {"frames": 2},
  {"key": "S", "alt": true},
  {"frames": 2},
  {"expect": {"query": {"command": "inspect.section_only", "path": ["on"], "value": true}}},
  {"call": "engine.execute", "params": {"command": "inspect.section", "params": {"clear": true}}},
  {"frames": 2},
  {"expect": {"query": {"command": "inspect.section", "params": {"hide": []}, "path": ["section"], "value": null}}},
  {"expect": {"errors": 0}}
]
